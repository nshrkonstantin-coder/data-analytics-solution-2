{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "POST without required fields",
      "method": "POST",
      "path": "/",
      "body": {"email": "test@test.com"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST valid request — sends real email",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Тест",
        "email": "test@test.com",
        "phone": "+7 999 000-00-00",
        "message": "Тестовое сообщение",
        "files": []
      },
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST with 3MB attachment — real email test",
      "method": "POST",
      "path": "/",
      "body": {"_test_with_attachment": true},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    }
  ]
}